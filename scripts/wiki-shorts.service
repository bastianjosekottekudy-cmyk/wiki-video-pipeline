[Unit]
Description=Wiki Shorts Video Pipeline Dashboard & Scheduler
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Projects/wiki-video-pipeline
ExecStart=%h/Projects/wiki-video-pipeline/.venv/bin/python -m src.main
Restart=always
RestartSec=5
KillMode=mixed
TimeoutStopSec=30
Environment=PYTHONUNBUFFERED=1
Environment=TZ=Asia/Kolkata
Environment=IMAGEIO_FFMPEG_EXE=/usr/bin/ffmpeg

[Install]
WantedBy=default.target
