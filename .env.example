# YouTube Data API — same channel as news-shorts-pipeline / trends-video-pipeline
YOUTUBE_CLIENT_SECRETS=secrets/client_secrets.json
YOUTUBE_REFRESH_TOKEN=
SKIP_YOUTUBE_UPLOAD=false

# Google Cloud API Key for Chirp 3 HD Text-to-Speech
GOOGLE_API_KEY=

# LLM Providers
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

DB_PATH=runs.db

LLM_CHAIN=groq/openai/gpt-oss-120b,gemini/gemini-3.6-flash,groq/openai/gpt-oss-20b,gemini/gemini-3.5-flash-lite,gemini/gemini-flash-lite-latest,openrouter/nvidia/nemotron-3-super-120b-a12b:free,openrouter/cohere/north-mini-code:free,openrouter/poolside/laguna-s-2.1:free
LLM_FALLBACKS=gemini/gemini-3.6-flash,groq/openai/gpt-oss-20b,gemini/gemini-3.5-flash-lite,gemini/gemini-flash-lite-latest,openrouter/nvidia/nemotron-3-super-120b-a12b:free,openrouter/cohere/north-mini-code:free,openrouter/poolside/laguna-s-2.1:free
